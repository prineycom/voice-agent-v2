#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
PID_FILE="$ROOT/tmp/review-stand.pid"
LOG_FILE="$ROOT/tmp/review-stand.log"
LOOPBACK_URL='http://127.0.0.1:8000/'
LOOPBACK_STATUS='http://127.0.0.1:8000/api/status'

running() {
  [ -f "$PID_FILE" ] || return 1
  PID=$(cat "$PID_FILE")
  [ -n "$PID" ] && kill -0 "$PID" 2>/dev/null || return 1
  [ -r "/proc/$PID/cmdline" ] || return 1
  tr '\000' ' ' < "/proc/$PID/cmdline" | grep -F "$ROOT/scripts/run_slice6.py" >/dev/null
}

start() {
  if running; then
    echo "Live review stand is already running (PID $(cat "$PID_FILE"))"
    status
    return
  fi
  rm -f "$PID_FILE"
  if [ -n "$(git -C "$ROOT" status --porcelain=v1 --untracked-files=all)" ]; then
    echo "Refusing to deploy a dirty worktree; commit the exact review head first." >&2
    exit 2
  fi
  [ -s "$ROOT/.env.slice6" ] || {
    echo "Missing non-empty operator-owned .env.slice6 runtime configuration." >&2
    exit 2
  }
  BUILD=$(git -C "$ROOT" rev-parse HEAD)
  mkdir -p "$ROOT/tmp"
  (
    cd "$ROOT/web"
    VITE_APP_VERSION="$BUILD" npm run build
  )
  grep -R -F "$BUILD" "$ROOT/web/dist/assets"/*.js >/dev/null || {
    echo "Production bundle does not contain the exact review head." >&2
    exit 2
  }
  DEPLOY_DIST=$(mktemp -d "$ROOT/tmp/review-stand-dist.$BUILD.XXXXXX")
  cp -a "$ROOT/web/dist/." "$DEPLOY_DIST/"
  nohup env \
    VOICE_AGENT_BUILD_ID="$BUILD" \
    VOICE_AGENT_WEB_DIST_OVERRIDE="$DEPLOY_DIST" \
    "$ROOT/run-slice6" >"$LOG_FILE" 2>&1 &
  PID=$!
  printf '%s\n' "$PID" > "$PID_FILE"
  for _attempt in $(seq 1 600); do
    if ! kill -0 "$PID" 2>/dev/null; then
      cat "$LOG_FILE" >&2
      rm -f "$PID_FILE"
      exit 1
    fi
    if curl --fail --silent --show-error "$LOOPBACK_URL" >/dev/null \
      && curl --fail --silent --show-error "$LOOPBACK_STATUS" >/dev/null; then
      echo "Live review stand started"
      echo "commit: $BUILD"
      echo "local: $LOOPBACK_URL"
      echo "external exposure: optional and operator-owned"
      echo "runtime log: $LOG_FILE"
      return
    fi
    sleep .5
  done
  echo "Live review stand did not become reachable within 300 seconds" >&2
  stop || true
  exit 1
}

stop() {
  if ! running; then
    rm -f "$PID_FILE"
    echo "Live review stand is not running"
    return
  fi
  PID=$(cat "$PID_FILE")
  kill "$PID"
  for _attempt in $(seq 1 1200); do
    kill -0 "$PID" 2>/dev/null || break
    sleep .1
  done
  if kill -0 "$PID" 2>/dev/null; then
    echo "Live review stand did not stop within 120 seconds" >&2
    exit 1
  fi
  rm -f "$PID_FILE"
  echo "Live review stand stopped"
}

status() {
  if running; then
    PID=$(cat "$PID_FILE")
    if curl --fail --silent --show-error "$LOOPBACK_STATUS" >/dev/null; then
      echo "running: PID $PID"
      echo "local: $LOOPBACK_URL"
      return
    fi
    echo "degraded: PID $PID is alive but the application API is unreachable" >&2
    exit 1
  fi
  echo "stopped"
}

case "${1:-status}" in
  start) start ;;
  stop) stop ;;
  restart) stop; start ;;
  status) status ;;
  *) echo "Usage: ./run-review-stand {start|stop|restart|status}" >&2; exit 2 ;;
esac
