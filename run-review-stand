#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
PID_FILE="$ROOT/tmp/review-stand.pid"
LOG_FILE="$ROOT/tmp/review-stand.log"
LOOPBACK_URL='http://127.0.0.1:4177/?review=1'
TAILNET_PORT=8447

hostname() {
  tailscale status --json | python3 -c '
import json, sys
name = json.load(sys.stdin)["Self"]["DNSName"].rstrip(".")
if not name:
    raise SystemExit("Tailscale DNS name is unavailable")
print(name)
'
}

running() {
  [ -f "$PID_FILE" ] || return 1
  PID=$(cat "$PID_FILE")
  [ -n "$PID" ] && kill -0 "$PID" 2>/dev/null || return 1
  [ -r "/proc/$PID/cmdline" ] || return 1
  tr '\000' ' ' < "/proc/$PID/cmdline" | grep -F "$ROOT/scripts/review_stand.py serve" >/dev/null
}

start() {
  if running; then
    echo "Review stand is already running (PID $(cat "$PID_FILE"))"
    status
    return
  fi
  rm -f "$PID_FILE"
  git -C "$ROOT" diff --quiet && git -C "$ROOT" diff --cached --quiet || {
    echo "Refusing to deploy a dirty worktree; commit the exact review head first." >&2
    exit 2
  }
  BUILD=$(git -C "$ROOT" rev-parse HEAD)
  mkdir -p "$ROOT/tmp"
  (
    cd "$ROOT/web"
    VITE_APP_VERSION="$BUILD" npm run build
  )
  nohup python3 "$ROOT/scripts/review_stand.py" serve >"$LOG_FILE" 2>&1 &
  PID=$!
  printf '%s\n' "$PID" > "$PID_FILE"
  TAILNET_URL="https://$(hostname):$TAILNET_PORT/?review=1"
  for _attempt in $(seq 1 80); do
    if ! kill -0 "$PID" 2>/dev/null; then
      cat "$LOG_FILE" >&2
      rm -f "$PID_FILE"
      exit 1
    fi
    if curl --fail --silent --show-error "$LOOPBACK_URL" >/dev/null \
      && curl --fail --silent --show-error "$TAILNET_URL" >/dev/null; then
      echo "Review stand started"
      echo "commit: $BUILD"
      echo "loopback: $LOOPBACK_URL"
      echo "tailnet: $TAILNET_URL"
      return
    fi
    sleep .25
  done
  echo "Review stand did not become reachable" >&2
  stop || true
  exit 1
}

stop() {
  if ! running; then
    rm -f "$PID_FILE"
    echo "Review stand is not running"
    return
  fi
  PID=$(cat "$PID_FILE")
  kill "$PID"
  for _attempt in $(seq 1 50); do
    kill -0 "$PID" 2>/dev/null || break
    sleep .1
  done
  if kill -0 "$PID" 2>/dev/null; then
    echo "Review stand did not stop within 5 seconds" >&2
    exit 1
  fi
  rm -f "$PID_FILE"
  echo "Review stand stopped"
}

status() {
  TAILNET_URL="https://$(hostname):$TAILNET_PORT/?review=1"
  if running; then
    PID=$(cat "$PID_FILE")
    if curl --fail --silent --show-error "$LOOPBACK_URL" >/dev/null \
      && curl --fail --silent --show-error "$TAILNET_URL" >/dev/null; then
      echo "running: PID $PID"
      echo "tailnet: $TAILNET_URL"
      return
    fi
    echo "degraded: PID $PID is alive but an endpoint is unreachable" >&2
    exit 1
  fi
  echo "stopped"
}

case "${1:-status}" in
  start) start ;;
  stop) stop ;;
  restart) stop; start ;;
  status) status ;;
  *) echo "Usage: ./run-review-stand {start|stop|restart|status}" >&2; exit 2 ;;
esac
