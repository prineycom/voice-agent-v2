#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
PYTHON=${PYTHON:-python3}

PYTHONPATH="$ROOT/src:$ROOT" "$PYTHON" -B -m unittest \
  tests.test_observability \
  tests.test_diagnostics \
  tests.test_slice6_realtime
PYTHONPATH="$ROOT/src" "$PYTHON" -B "$ROOT/scripts/verify_slice8.py"
(
  cd "$ROOT/web"
  npm run typecheck
  npm test -- --run \
    src/state.test.ts \
    src/ui/stateMapping.test.ts \
    src/avatar/avatar.test.ts \
    src/App.test.tsx \
    src/voiceClient.test.ts
)

printf '%s\n' 'Slice 8 failure semantics and privacy-safe observability: PASS'
printf '%s\n' 'Physical microphone/audibility/Raspberry Pi/destructive OOM: NOT CLAIMED'
