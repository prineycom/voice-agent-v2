#!/usr/bin/env python3
"""Fixed in-container helper for ordinary persistent development work.

The controller can only invoke this executable through ``docker container exec``.
It keeps the at-most-once receipt ledger in the writable container rootfs; user
files remain ordinary container files rather than gateway paths.
"""

from __future__ import annotations

import argparse
import base64
from dataclasses import dataclass, field
import hashlib
import json
import os
from pathlib import Path
import re
import resource
import shutil
import signal
import stat
import subprocess
import sys
import tempfile
import threading
import time

LEDGER = Path(os.environ.get("VOICE_AGENT_LEDGER", "/var/lib/voice-agent/exec-ledger"))
STREAM_LEDGER = Path(os.environ.get("VOICE_AGENT_STREAM_LEDGER", "/var/lib/voice-agent/stream-ledger"))
PROCESS_LEDGER = Path(os.environ.get("VOICE_AGENT_PROCESS_LEDGER", "/var/lib/voice-agent/process-ledger"))
PROCESS_RUNTIME = Path(os.environ.get("VOICE_AGENT_PROCESS_RUNTIME", "/run/voice-agent-processes"))
MAX_LEDGER = 4096
MAX_INPUT = 256 * 1024
MAX_STREAM_BYTES = 1024 * 1024
# The Docker exec JSON envelope base64-encodes stdout, so this deliberately
# stays below the controller's 256-KiB wire-output limit.
MAX_OUTPUT = 128 * 1024
MAX_FILE_BYTES = 8 * 1024 * 1024
MAX_SEARCH_MATCHES = 256
MAX_PROCESS_LOG_BYTES = 256 * 1024
MAX_PROCESS_WRITE_BYTES = 64 * 1024
MAX_PROCESS_WAIT_SECONDS = 30.0
MAX_PROCESS_RECEIPTS = 64
PROCESS_RECEIPT = re.compile(r"^[a-f0-9]{32}$")
CALL_ID = re.compile(r"^[a-f0-9]{32}$")
SHA256 = re.compile(r"^[a-f0-9]{64}$")
CREDENTIAL_NAME = re.compile(r"^(?!VOICE_AGENT_)[A-Z_][A-Z0-9_]{0,63}$")
STREAM_ROOTS = {"workspace": Path("/workspace"), "cache": Path("/cache")}


@dataclass(slots=True)
class Captured:
    data: bytes = b""
    byte_count: int = 0
    digest: hashlib._Hash = field(default_factory=hashlib.sha256)
    truncated: bool = False

    def add(self, chunk: bytes) -> None:
        self.byte_count += len(chunk)
        self.digest.update(chunk)
        if len(self.data) < MAX_OUTPUT:
            remaining = MAX_OUTPUT - len(self.data)
            self.data += chunk[:remaining]
        if self.byte_count > MAX_OUTPUT:
            self.truncated = True


def emit(value: dict[str, object]) -> None:
    sys.stdout.write(json.dumps(value, sort_keys=True, separators=(",", ":")))


def input_document() -> dict[str, object]:
    raw = sys.stdin.buffer.read(MAX_INPUT + 1)
    if len(raw) > MAX_INPUT:
        raise ValueError("input_out_of_bounds")
    value = json.loads(raw or b"{}")
    if not isinstance(value, dict):
        raise ValueError("input_invalid")
    return value


def atomic_json(path: Path, value: dict[str, object]) -> None:
    descriptor, name = tempfile.mkstemp(prefix=".receipt-", dir=path.parent)
    temporary = Path(name)
    try:
        os.fchmod(descriptor, 0o600)
        with os.fdopen(descriptor, "w", encoding="utf-8") as output:
            json.dump(value, output, sort_keys=True, separators=(",", ":"))
            output.flush()
            os.fsync(output.fileno())
        os.replace(temporary, path)
        _fsync_directory(path.parent)
    finally:
        temporary.unlink(missing_ok=True)


def _fsync_directory(directory: Path) -> None:
    descriptor = os.open(directory, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


def _metadata(captured: Captured, *, prefix: str) -> dict[str, object]:
    return {
        f"{prefix}_bytes": captured.byte_count,
        f"{prefix}_sha256": captured.digest.hexdigest(),
        f"{prefix}_truncated": captured.truncated,
    }


def receipt(
    status: str,
    exit_code: int | None,
    stdout: Captured,
    stderr: Captured,
    cwd: str,
    *,
    details: dict[str, object] | None = None,
    replayed: bool = False,
) -> dict[str, object]:
    result: dict[str, object] = {
        "status": status,
        "exit_code": exit_code,
        "stdout_base64": base64.b64encode(stdout.data).decode("ascii"),
        "stderr_base64": base64.b64encode(stderr.data).decode("ascii"),
        "cwd": cwd,
        "replayed": replayed,
        **_metadata(stdout, prefix="stdout"),
        **_metadata(stderr, prefix="stderr"),
    }
    if details:
        result["details"] = details
    return result


def captured(data: bytes) -> Captured:
    result = Captured()
    result.add(data)
    return result


def error_result(code: str, cwd: str, *, details: dict[str, object] | None = None) -> dict[str, object]:
    return receipt("failed", 2, captured(b""), captured(code.encode("ascii")), cwd, details=details)


def safe_cwd(value: str) -> str:
    path = Path(value)
    if not path.is_absolute() or not path.is_dir():
        return "/workspace"
    return str(path)


def _relative(path: str, cwd: str) -> Path:
    candidate = Path(path)
    if not str(path) or "\0" in str(path):
        raise ValueError("path_invalid")
    return candidate if candidate.is_absolute() else Path(cwd) / candidate


def _regular(path: Path) -> os.stat_result:
    metadata = path.stat()
    if not stat.S_ISREG(metadata.st_mode):
        raise ValueError("path_not_regular")
    if metadata.st_size > MAX_FILE_BYTES:
        raise ValueError("file_out_of_bounds")
    return metadata


def _sha256_path(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as source:
        while chunk := source.read(64 * 1024):
            digest.update(chunk)
    return digest.hexdigest()


def _expected(value: object, *, name: str) -> str | None:
    if value is None:
        return None
    if not isinstance(value, str) or not SHA256.fullmatch(value):
        raise ValueError(f"{name}_invalid")
    return value


def _atomic_replace(target: Path, data: bytes, *, expected_current: str | None = None) -> dict[str, object]:
    target.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    if expected_current is not None:
        if not target.exists() or _sha256_path(target) != expected_current:
            raise ValueError("expected_current_sha256_mismatch")
    descriptor, name = tempfile.mkstemp(prefix=f".{target.name}.", dir=target.parent)
    temporary = Path(name)
    try:
        os.fchmod(descriptor, 0o600)
        with os.fdopen(descriptor, "wb", closefd=True) as output:
            output.write(data)
            output.flush()
            os.fsync(output.fileno())
        os.replace(temporary, target)
        _fsync_directory(target.parent)
    finally:
        temporary.unlink(missing_ok=True)
    return {"bytes": len(data), "sha256": hashlib.sha256(data).hexdigest(), "mode": "0600", "atomic": True}


def _file_read(data: dict[str, object], cwd: str) -> dict[str, object]:
    path = _relative(str(data.get("path", "")), cwd)
    metadata = _regular(path)
    offset = data.get("offset", 0)
    length = data.get("length", MAX_OUTPUT)
    if type(offset) is not int or type(length) is not int or offset < 0 or length < 0 or length > MAX_OUTPUT:
        raise ValueError("range_invalid")
    with path.open("rb") as source:
        source.seek(offset)
        output = source.read(length)
    total_hash = _sha256_path(path)
    end = offset + len(output)
    return receipt(
        "completed", 0, captured(output), captured(b""), cwd,
        details={
            "kind": "file_read", "file_bytes": metadata.st_size, "file_sha256": total_hash,
            "mode": f"{stat.S_IMODE(metadata.st_mode):04o}", "range_start": offset,
            "range_end": end, "range_complete": end >= metadata.st_size,
            "range_truncated": end < metadata.st_size,
        },
    )


def _file_search(data: dict[str, object], cwd: str) -> dict[str, object]:
    root = _relative(str(data.get("path", cwd)), cwd)
    query = data.get("query", "")
    if not isinstance(query, str) or not query or len(query.encode("utf-8")) > 4096 or not root.is_dir():
        raise ValueError("search_invalid")
    needle = query.encode("utf-8")
    matches: list[str] = []
    scanned = 0
    complete = True
    for candidate in sorted(root.rglob("*")):
        if candidate.is_symlink() or not candidate.is_file():
            continue
        metadata = candidate.stat()
        if metadata.st_size > MAX_FILE_BYTES or scanned + metadata.st_size > MAX_FILE_BYTES:
            complete = False
            break
        scanned += metadata.st_size
        content = candidate.read_bytes()
        start = 0
        while (position := content.find(needle, start)) >= 0:
            relative = str(candidate.relative_to(root))
            entry = f"{relative}:{position}\n"
            if sum(len(value.encode("utf-8")) for value in matches) + len(entry.encode("utf-8")) > MAX_OUTPUT:
                complete = False
                break
            matches.append(entry)
            if len(matches) >= MAX_SEARCH_MATCHES:
                complete = False
                break
            start = position + max(1, len(needle))
        if not complete:
            break
    output = "".join(matches).encode("utf-8")
    return receipt(
        "completed", 0, captured(output), captured(b""), cwd,
        details={"kind": "file_search", "match_count": len(matches), "scanned_bytes": scanned, "complete": complete},
    )


def _file_write(data: dict[str, object], cwd: str) -> dict[str, object]:
    target = _relative(str(data.get("path", "")), cwd)
    encoded = data.get("data_base64", "")
    if not isinstance(encoded, str):
        raise ValueError("data_invalid")
    content = base64.b64decode(encoded, validate=True)
    if len(content) > MAX_FILE_BYTES:
        raise ValueError("file_out_of_bounds")
    expected_bytes = data.get("expected_bytes")
    expected_hash = _expected(data.get("expected_sha256"), name="expected_sha256")
    expected_current = _expected(data.get("expected_current_sha256"), name="expected_current_sha256")
    if expected_bytes is not None and (type(expected_bytes) is not int or expected_bytes != len(content)):
        raise ValueError("expected_bytes_mismatch")
    if expected_hash is not None and expected_hash != hashlib.sha256(content).hexdigest():
        raise ValueError("expected_sha256_mismatch")
    details = _atomic_replace(target, content, expected_current=expected_current)
    details["kind"] = "file_write"
    return receipt("completed", 0, captured(b""), captured(b""), cwd, details=details)


def _file_edit(data: dict[str, object], cwd: str) -> dict[str, object]:
    target = _relative(str(data.get("path", "")), cwd)
    _regular(target)
    old = data.get("old_text")
    new = data.get("new_text")
    if not isinstance(old, str) or not isinstance(new, str):
        raise ValueError("edit_invalid")
    original = target.read_bytes()
    old_bytes, new_bytes = old.encode("utf-8"), new.encode("utf-8")
    if original.count(old_bytes) != 1:
        raise ValueError("edit_expected_text_not_unique")
    updated = original.replace(old_bytes, new_bytes, 1)
    expected_current = _expected(data.get("expected_current_sha256"), name="expected_current_sha256")
    details = _atomic_replace(target, updated, expected_current=expected_current)
    details["kind"] = "file_edit"
    return receipt("completed", 0, captured(b""), captured(b""), cwd, details=details)


def _file_patch(data: dict[str, object], cwd: str) -> dict[str, object]:
    target = _relative(str(data.get("path", "")), cwd)
    _regular(target)
    patch = data.get("patch")
    if not isinstance(patch, str) or len(patch.encode("utf-8")) > MAX_INPUT:
        raise ValueError("patch_invalid")
    expected_current = _expected(data.get("expected_current_sha256"), name="expected_current_sha256")
    if expected_current is not None and _sha256_path(target) != expected_current:
        raise ValueError("expected_current_sha256_mismatch")
    descriptor, name = tempfile.mkstemp(prefix=f".{target.name}.", dir=target.parent)
    temporary = Path(name)
    os.close(descriptor)
    try:
        temporary.unlink()
        process = subprocess.run(
            ["/usr/bin/patch", "--batch", "--forward", "--output", str(temporary), str(target)],
            input=patch.encode("utf-8"), stdout=subprocess.PIPE, stderr=subprocess.PIPE,
            check=False, env=_tool_environment(), timeout=30,
        )
        if process.returncode != 0 or not temporary.is_file():
            return receipt("failed", process.returncode, captured(process.stdout), captured(process.stderr), cwd,
                           details={"kind": "file_patch", "atomic": True, "applied": False})
        content = temporary.read_bytes()
        if len(content) > MAX_FILE_BYTES:
            raise ValueError("file_out_of_bounds")
        with temporary.open("r+b") as output:
            os.fchmod(output.fileno(), 0o600)
            output.flush()
            os.fsync(output.fileno())
        os.replace(temporary, target)
        _fsync_directory(target.parent)
        details = {"kind": "file_patch", "bytes": len(content), "sha256": hashlib.sha256(content).hexdigest(), "mode": "0600", "atomic": True, "applied": True}
        return receipt("completed", 0, captured(process.stdout), captured(process.stderr), cwd, details=details)
    finally:
        temporary.unlink(missing_ok=True)


def _tool_environment() -> dict[str, str]:
    # Deliberately do not inherit host/controller Git, SSH, GPG, Docker, or
    # credential state. Only controller-fixed declared names cross this seam.
    result = {
        "HOME": "/workspace",
        "PATH": "/usr/local/bin:/usr/bin:/bin",
        "LANG": "C.UTF-8",
        "LC_ALL": "C.UTF-8",
        "GIT_CONFIG_NOSYSTEM": "1",
        "GIT_CONFIG_GLOBAL": "/dev/null",
        "GIT_TERMINAL_PROMPT": "0",
        "GIT_ASKPASS": "/bin/false",
    }
    for declaration in (
        "VOICE_AGENT_CREATE_ENV_NAMES", "VOICE_AGENT_CREATE_FILE_NAMES",
        "VOICE_AGENT_EXEC_ENV_NAMES", "VOICE_AGENT_EXEC_FILE_NAMES",
    ):
        raw = os.environ.get(declaration, "")
        for name in raw.split(",") if raw else ():
            if CREDENTIAL_NAME.fullmatch(name) and name in os.environ:
                result[name] = os.environ[name]
    return result


def _drain(stream, result: Captured) -> None:
    try:
        while chunk := stream.read(64 * 1024):
            result.add(chunk)
    finally:
        stream.close()


def _run_process(command: list[str], *, cwd: str, stdin: bytes, call: Path) -> tuple[int | None, Captured, Captured, bool]:
    environment = _tool_environment()
    environment["VOICE_AGENT_INTERNAL_CALL_ID"] = call.name
    process = subprocess.Popen(
        command, cwd=cwd, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
        start_new_session=True, env=environment,
    )
    identity = _proc_identity(process.pid)
    if identity is None or identity["pgid"] != process.pid:
        try:
            os.killpg(process.pid, signal.SIGKILL)
        except OSError:
            pass
        raise ValueError("foreground_process_identity_unknown")
    atomic_json(call / "foreground-process.json", {"schema": 1, "identity": identity})
    stdout, stderr = Captured(), Captured()
    stdout_thread = threading.Thread(target=_drain, args=(process.stdout, stdout), daemon=True)
    stderr_thread = threading.Thread(target=_drain, args=(process.stderr, stderr), daemon=True)
    stdout_thread.start(); stderr_thread.start()
    assert process.stdin is not None
    try:
        process.stdin.write(stdin)
        process.stdin.close()
        process.wait(timeout=600)
        cancelled = False
    except subprocess.TimeoutExpired:
        os.killpg(process.pid, signal.SIGTERM)
        try:
            process.wait(timeout=5)
        except subprocess.TimeoutExpired:
            os.killpg(process.pid, signal.SIGKILL)
            process.wait()
        cancelled = True
    finally:
        stdout_thread.join(); stderr_thread.join()
    return process.returncode, stdout, stderr, cancelled


def _shell(data: dict[str, object], cwd: str, call: Path) -> dict[str, object]:
    command = data.get("command", "")
    if not isinstance(command, str) or len(command.encode("utf-8")) > MAX_INPUT:
        raise ValueError("command_invalid")
    cwd_record = call / "cwd"
    # $1 is data, never shell source construction. The footer observes the
    # final directory of this fresh shell, so only an explicit successful cd
    # affects the next call.
    shell = 'eval "$1"; code=$?; /bin/pwd > "$2"; exit "$code"'
    code, stdout, stderr, cancelled = _run_process(["/bin/sh", "-c", shell, "shell-exec", command, str(cwd_record)], cwd=cwd, stdin=b"", call=call)
    next_cwd = safe_cwd(cwd_record.read_text(encoding="utf-8").strip()) if cwd_record.exists() else "/workspace"
    if cancelled:
        return receipt("cancelled", None, stdout, stderr, next_cwd, details={"kind": "shell", "output_complete": False})
    output_complete = not stdout.truncated and not stderr.truncated
    status = "completed" if code == 0 and output_complete else "failed"
    return receipt(status, code if output_complete else 75, stdout, stderr, next_cwd,
                   details={"kind": "shell", "output_complete": output_complete})


def _execute_code(data: dict[str, object], cwd: str, call: Path) -> dict[str, object]:
    language = data.get("language", "python")
    code = data.get("code", "")
    interpreters = {"python": "/usr/bin/python3", "sh": "/bin/sh"}
    if language not in interpreters or not isinstance(code, str) or len(code.encode("utf-8")) > MAX_INPUT:
        raise ValueError("code_invalid")
    returncode, stdout, stderr, cancelled = _run_process([interpreters[language], "-"], cwd=cwd, stdin=code.encode("utf-8"), call=call)
    if cancelled:
        return receipt("cancelled", None, stdout, stderr, cwd, details={"kind": "execute_code", "output_complete": False})
    complete = not stdout.truncated and not stderr.truncated
    return receipt("completed" if returncode == 0 and complete else "failed", returncode if complete else 75, stdout, stderr, cwd,
                   details={"kind": "execute_code", "output_complete": complete})


def _proc_identity(pid: int) -> dict[str, object] | None:
    """Read fresh Linux identity; a PID without all fields is never signal authority."""
    if pid <= 1:
        return None
    try:
        stat_line = Path(f"/proc/{pid}/stat").read_text(encoding="ascii")
        suffix = stat_line.rsplit(")", 1)[1].split()
        state = suffix[0]
        pgid = int(suffix[2])
        start_time = int(suffix[19])
        init_line = Path("/proc/1/stat").read_text(encoding="ascii")
        init_start_time = int(init_line.rsplit(")", 1)[1].split()[19])
        executable = os.readlink(f"/proc/{pid}/exe")
    except (OSError, ValueError, IndexError):
        return None
    if state == "Z":
        return None
    return {
        "pid": pid, "pgid": pgid, "start_time": start_time,
        "executable": executable, "init_start_time": init_start_time,
    }


def _background_preexec() -> None:
    os.setsid()
    resource.setrlimit(resource.RLIMIT_FSIZE, (MAX_PROCESS_LOG_BYTES, MAX_PROCESS_LOG_BYTES))


def _background(data: dict[str, object], cwd: str, *, tool: str) -> dict[str, object]:
    process_receipt = data.get("_voice_agent_process_receipt")
    owner = data.get("_voice_agent_owner")
    spec = data.get("_voice_agent_spec")
    generation = data.get("_voice_agent_generation")
    if (
        not isinstance(process_receipt, str) or not PROCESS_RECEIPT.fullmatch(process_receipt)
        or not isinstance(owner, str) or not owner or not isinstance(spec, str) or not spec
        or type(generation) is not int or generation < 1
    ):
        raise ValueError("background_identity_invalid")
    PROCESS_LEDGER.mkdir(mode=0o700, parents=True, exist_ok=True)
    if sum(1 for item in PROCESS_LEDGER.iterdir() if item.is_dir()) >= MAX_PROCESS_RECEIPTS:
        raise ValueError("background_process_limit_reached")
    claim = PROCESS_LEDGER / process_receipt
    try:
        claim.mkdir(mode=0o700)
    except FileExistsError as error:
        raise ValueError("background_receipt_conflict") from error
    PROCESS_RUNTIME.mkdir(mode=0o700, parents=True, exist_ok=True)
    fifo = PROCESS_RUNTIME / f"{process_receipt}.stdin"
    stdout_path = claim / "stdout.log"
    stderr_path = claim / "stderr.log"
    code_path: Path | None = None
    try:
        os.mkfifo(fifo, 0o600)
        fifo_descriptor = os.open(fifo, os.O_RDWR | os.O_NONBLOCK)
        os.set_blocking(fifo_descriptor, True)
        stdout_file = stdout_path.open("wb", buffering=0)
        stderr_file = stderr_path.open("wb", buffering=0)
        if tool == "shell-exec":
            command = data.get("command", "")
            if not isinstance(command, str) or len(command.encode("utf-8")) > MAX_INPUT:
                raise ValueError("command_invalid")
            # The fixed footer prevents the shell from exec-optimising its last
            # child, so the freshly reconciled executable remains stable.
            argv = ["/bin/sh", "-c", 'eval "$1"; code=$?; :; exit "$code"', "background", command]
        else:
            language = data.get("language", "python")
            code = data.get("code", "")
            interpreters = {"python": "/usr/bin/python3", "sh": "/bin/sh"}
            if language not in interpreters or not isinstance(code, str) or len(code.encode("utf-8")) > MAX_INPUT:
                raise ValueError("code_invalid")
            code_path = claim / ("program.py" if language == "python" else "program.sh")
            descriptor = os.open(code_path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
            with os.fdopen(descriptor, "wb") as output:
                output.write(code.encode("utf-8"))
            argv = [interpreters[language], str(code_path)]
        process = subprocess.Popen(
            argv, cwd=cwd, stdin=fifo_descriptor, stdout=stdout_file, stderr=stderr_file,
            close_fds=True, env=_tool_environment(), preexec_fn=_background_preexec,
        )
        os.close(fifo_descriptor)
        stdout_file.close(); stderr_file.close()
        identity = _proc_identity(process.pid)
        if identity is None or identity["pgid"] != process.pid:
            raise ValueError("background_process_exited_before_receipt")
        document = {
            "schema": 1, "receipt": process_receipt, "owner": owner, "spec": spec,
            "generation": generation, "identity": identity, "state": "running",
        }
        atomic_json(claim / "process.json", document)
        return receipt(
            "completed", 0, captured(b""), captured(b""), cwd,
            details={
                "schema_version": "voice-agent.process-receipt.v1",
                "kind": "background_process", "process_receipt": process_receipt,
                "state": "running", "writable_stdin": True,
                "operations": ["poll", "logs", "wait", "write", "kill"],
                "_voice_agent_identity": identity,
            },
        )
    except Exception:
        # A process that escaped receipt creation must not be left unowned.
        candidate = locals().get("process")
        if isinstance(candidate, subprocess.Popen) and candidate.poll() is None:
            try:
                os.killpg(candidate.pid, signal.SIGKILL)
            except OSError:
                pass
        shutil.rmtree(claim, ignore_errors=True)
        fifo.unlink(missing_ok=True)
        raise


def _validated_process(data: dict[str, object]) -> tuple[Path, dict[str, object], dict[str, object] | None]:
    process_receipt = data.get("receipt")
    expected = data.get("_voice_agent_expected_identity")
    claim_path = PROCESS_LEDGER / str(process_receipt)
    try:
        document = json.loads((claim_path / "process.json").read_text(encoding="utf-8"))
    except (OSError, ValueError, TypeError) as error:
        raise ValueError("process_identity_unknown") from error
    exact = {
        "schema": 1, "receipt": process_receipt, "owner": data.get("_voice_agent_owner"),
        "spec": data.get("_voice_agent_spec"), "generation": data.get("_voice_agent_generation"),
        "identity": expected, "state": document.get("state"),
    }
    if (
        not isinstance(process_receipt, str) or not PROCESS_RECEIPT.fullmatch(process_receipt)
        or not isinstance(expected, dict) or document != exact
    ):
        raise ValueError("process_identity_unknown")
    pid = expected.get("pid")
    fresh = _proc_identity(pid) if type(pid) is int else None
    if fresh != expected:
        return claim_path, document, None
    return claim_path, document, fresh


def _process_operation(data: dict[str, object], cwd: str) -> dict[str, object]:
    action = data.get("action", "poll")
    if action not in {"poll", "logs", "wait", "write", "kill"}:
        raise ValueError("process_action_invalid")
    claim, document, fresh = _validated_process(data)
    timeout = data.get("timeout_seconds", 0)
    if type(timeout) not in {int, float} or not 0 <= float(timeout) <= MAX_PROCESS_WAIT_SECONDS:
        raise ValueError("process_wait_out_of_bounds")
    if action == "wait" and fresh is not None:
        deadline = time.monotonic() + float(timeout)
        while fresh is not None and time.monotonic() < deadline:
            time.sleep(min(0.05, max(0.0, deadline - time.monotonic())))
            fresh = _proc_identity(int(document["identity"]["pid"]))
            if fresh != document["identity"]:
                fresh = None
    if action == "kill" and fresh is not None:
        identity = document["identity"]
        os.killpg(int(identity["pgid"]), signal.SIGTERM)
        deadline = time.monotonic() + 5.0
        while time.monotonic() < deadline and _proc_identity(int(identity["pid"])) == identity:
            time.sleep(0.05)
        latest = _proc_identity(int(identity["pid"]))
        if latest == identity:
            # Revalidation immediately before KILL is the PID-reuse defence.
            os.killpg(int(identity["pgid"]), signal.SIGKILL)
            deadline = time.monotonic() + 1.0
            while time.monotonic() < deadline and _proc_identity(int(identity["pid"])) == identity:
                time.sleep(0.02)
        fresh = _proc_identity(int(identity["pid"]))
        if fresh not in (None, identity):
            raise ValueError("process_identity_unknown")
        fresh = None
        document["state"] = "killed"
        atomic_json(claim / "process.json", document)
    state = "running" if fresh is not None else str(document.get("state", "gone"))
    if fresh is None and state == "running":
        state = "gone"
        document["state"] = state
        atomic_json(claim / "process.json", document)
    if action == "write":
        if fresh is None:
            return error_result("process_gone", cwd, details={"kind": "process", "state": state})
        try:
            value = base64.b64decode(str(data.get("data_base64", "")), validate=True)
        except ValueError as error:
            raise ValueError("process_write_invalid") from error
        if len(value) > MAX_PROCESS_WRITE_BYTES:
            raise ValueError("process_write_out_of_bounds")
        try:
            descriptor = os.open(PROCESS_RUNTIME / f"{data['receipt']}.stdin", os.O_WRONLY | os.O_NONBLOCK)
            try:
                written = os.write(descriptor, value)
            finally:
                os.close(descriptor)
        except OSError:
            return error_result("process_write_unsupported", cwd, details={"kind": "process", "state": state})
        return receipt("completed", 0, captured(b""), captured(b""), cwd,
                       details={"kind": "process", "state": state, "written_bytes": written})
    stdout = captured(b""); stderr = captured(b"")
    if action == "logs":
        offset = data.get("offset", 0)
        maximum = data.get("maximum_bytes", MAX_OUTPUT)
        if type(offset) is not int or offset < 0 or type(maximum) is not int or not 1 <= maximum <= MAX_OUTPUT:
            raise ValueError("process_logs_out_of_bounds")
        for path, output in ((claim / "stdout.log", stdout), (claim / "stderr.log", stderr)):
            try:
                with path.open("rb") as source:
                    source.seek(offset)
                    output.add(source.read(maximum))
            except OSError:
                pass
    return receipt(
        "completed", 0, stdout, stderr, cwd,
        details={
            "kind": "process", "process_receipt": data.get("receipt"), "action": action,
            "state": state, "timed_out": action == "wait" and fresh is not None,
            "stdout_next_offset": (data.get("offset", 0) + len(stdout.data)) if action == "logs" else 0,
            "stderr_next_offset": (data.get("offset", 0) + len(stderr.data)) if action == "logs" else 0,
        },
    )


def _creation_file_material() -> list[tuple[str, bytes]]:
    try:
        count = int(os.environ.get("VOICE_AGENT_CREATE_FILE_COUNT", "0"))
    except ValueError as error:
        raise ValueError("credential_creation_invalid") from error
    if not 0 <= count <= 16:
        raise ValueError("credential_creation_invalid")
    result: list[tuple[str, bytes]] = []
    for index in range(count):
        name = os.environ.get(f"VOICE_AGENT_CREATE_FILE_NAME_{index}", "")
        encoded = os.environ.get(f"VOICE_AGENT_CREATE_FILE_B64_{index}", "")
        if not CREDENTIAL_NAME.fullmatch(name):
            raise ValueError("credential_creation_invalid")
        try:
            content = base64.b64decode(encoded, validate=True)
        except ValueError as error:
            raise ValueError("credential_creation_invalid") from error
        if len(content) > 64 * 1024:
            raise ValueError("credential_creation_invalid")
        result.append((name, content))
    if len({name for name, _content in result}) != len(result):
        raise ValueError("credential_creation_invalid")
    return result


def initialize_creation_files() -> None:
    for name, content in _creation_file_material():
        _atomic_replace(Path("/var/lib/voice-agent/credentials") / name, content)


def creation_files_ready() -> bool:
    try:
        for name, content in _creation_file_material():
            target = Path("/var/lib/voice-agent/credentials") / name
            metadata = _regular(target)
            if stat.S_IMODE(metadata.st_mode) != 0o600 or metadata.st_size != len(content) or _sha256_path(target) != hashlib.sha256(content).hexdigest():
                return False
        return True
    except (OSError, ValueError):
        return False


def _credential_path(scope: str, name: str, call_id: str | None) -> Path:
    if not CREDENTIAL_NAME.fullmatch(name):
        raise ValueError("credential_name_invalid")
    if scope == "creation" and call_id is None:
        return Path("/var/lib/voice-agent/credentials") / name
    if scope == "exec" and call_id is not None and CALL_ID.fullmatch(call_id):
        return Path("/run/voice-agent-credentials") / call_id / name
    raise ValueError("credential_scope_invalid")


def credential_file_put(arguments: argparse.Namespace) -> int:
    try:
        expected_bytes = int(arguments.expected_bytes)
        if expected_bytes < 0 or expected_bytes > 64 * 1024 or not SHA256.fullmatch(arguments.expected_sha256):
            raise ValueError("credential_bounds_invalid")
        content = sys.stdin.buffer.read(expected_bytes + 1)
        if len(content) != expected_bytes or hashlib.sha256(content).hexdigest() != arguments.expected_sha256:
            raise ValueError("credential_bytes_mismatch")
        target = _credential_path(arguments.scope, arguments.name, arguments.call_id)
        _atomic_replace(target, content)
        emit({"status": "stored", "bytes": len(content), "mode": "0600"})
        return 0
    except (OSError, ValueError):
        print("credential_injection_failed", file=sys.stderr)
        return 2


def credential_file_clean(call_id: str) -> int:
    if not CALL_ID.fullmatch(call_id):
        return 2
    root = Path("/run/voice-agent-credentials") / call_id
    try:
        shutil.rmtree(root)
    except FileNotFoundError:
        pass
    except OSError:
        return 3
    return 0


def _stream_path(root_name: str, relative: str, *, create_parent: bool) -> Path:
    root = STREAM_ROOTS.get(root_name)
    candidate_relative = Path(relative)
    if (
        root is None or not relative or "\0" in relative or candidate_relative.is_absolute()
        or any(part in {"", ".", ".."} for part in candidate_relative.parts)
    ):
        raise ValueError("stream_path_invalid")
    target = root / candidate_relative
    if create_parent:
        target.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    resolved_parent = target.parent.resolve(strict=True)
    try:
        resolved_parent.relative_to(root)
    except ValueError as error:
        raise ValueError("stream_path_invalid") from error
    if target.is_symlink():
        raise ValueError("stream_path_invalid")
    return resolved_parent / target.name


def stream_in(arguments: argparse.Namespace) -> int:
    if not CALL_ID.fullmatch(arguments.transfer_id):
        return 2
    STREAM_LEDGER.mkdir(mode=0o700, parents=True, exist_ok=True)
    existing = sorted((item for item in STREAM_LEDGER.iterdir() if item.is_dir()), key=lambda item: item.stat().st_mtime_ns)
    if len(existing) >= MAX_LEDGER:
        completed = [item for item in existing if (item / "receipt.json").is_file()]
        for old in completed[:len(existing) - MAX_LEDGER + 1]:
            shutil.rmtree(old)
        if sum(1 for item in STREAM_LEDGER.iterdir() if item.is_dir()) >= MAX_LEDGER:
            return 3
    claim = STREAM_LEDGER / arguments.transfer_id
    try:
        claim.mkdir(mode=0o700)
    except FileExistsError:
        try:
            emit(json.loads((claim / "receipt.json").read_text(encoding="utf-8")))
            return 0
        except (OSError, ValueError, TypeError):
            return 3
    try:
        expected_bytes = int(arguments.expected_bytes)
        if expected_bytes < 0 or expected_bytes > MAX_STREAM_BYTES or not SHA256.fullmatch(arguments.expected_sha256):
            raise ValueError("stream_bounds_invalid")
        content = sys.stdin.buffer.read(expected_bytes + 1)
        if len(content) != expected_bytes or hashlib.sha256(content).hexdigest() != arguments.expected_sha256:
            raise ValueError("stream_bytes_mismatch")
        target = _stream_path(arguments.root, arguments.path, create_parent=True)
        details = _atomic_replace(target, content)
        document = {
            "status": "stored", "transfer_id": arguments.transfer_id,
            "path": f"/{arguments.root}/{arguments.path}", **details,
        }
        atomic_json(claim / "receipt.json", document)
        emit(document)
        claims = sorted((item for item in STREAM_LEDGER.iterdir() if item.is_dir()), key=lambda item: item.stat().st_mtime_ns)
        removable = [item for item in claims if (item / "receipt.json").is_file() and item != claim]
        for old in removable[:max(0, len(claims) - MAX_LEDGER)]:
            shutil.rmtree(old)
        return 0
    except (OSError, ValueError):
        return 2


def _stream_content(arguments: argparse.Namespace) -> tuple[Path, bytes]:
    target = _stream_path(arguments.root, arguments.path, create_parent=False)
    metadata = _regular(target)
    if metadata.st_size > MAX_STREAM_BYTES:
        raise ValueError("stream_out_of_bounds")
    content = target.read_bytes()
    return target, content


def stream_stat(arguments: argparse.Namespace) -> int:
    try:
        _target, content = _stream_content(arguments)
        emit({"bytes": len(content), "sha256": hashlib.sha256(content).hexdigest()})
        return 0
    except (OSError, ValueError):
        return 2


def stream_out(arguments: argparse.Namespace) -> int:
    try:
        expected_bytes = int(arguments.expected_bytes)
        if expected_bytes < 0 or expected_bytes > MAX_STREAM_BYTES or not SHA256.fullmatch(arguments.expected_sha256):
            raise ValueError("stream_bounds_invalid")
        _target, content = _stream_content(arguments)
        if len(content) != expected_bytes or hashlib.sha256(content).hexdigest() != arguments.expected_sha256:
            raise ValueError("stream_bytes_mismatch")
        sys.stdout.buffer.write(content)
        sys.stdout.buffer.flush()
        return 0
    except (OSError, ValueError):
        return 2


def execute(tool: str, data: dict[str, object], cwd: str, call: Path) -> dict[str, object]:
    current = safe_cwd(cwd)
    if data.get("background") is True and tool in {"shell-exec", "execute-code"}:
        return _background(data, current, tool=tool)
    if tool == "shell-exec":
        return _shell(data, current, call)
    if tool == "file-read":
        return _file_read(data, current)
    if tool == "file-search":
        return _file_search(data, current)
    if tool == "file-write":
        return _file_write(data, current)
    if tool == "file-edit":
        return _file_edit(data, current)
    if tool == "file-patch":
        return _file_patch(data, current)
    if tool == "execute-code":
        return _execute_code(data, current, call)
    if tool in {"process", "receipt"}:
        return _process_operation(data, current)
    raise ValueError("tool_invalid")


def claim_execute(arguments: argparse.Namespace) -> int:
    if not CALL_ID.fullmatch(arguments.call_id):
        return 2
    LEDGER.mkdir(mode=0o700, parents=True, exist_ok=True)
    call = LEDGER / arguments.call_id
    try:
        call.mkdir(mode=0o700)
        claimed = True
    except FileExistsError:
        claimed = False
    receipt_path = call / "receipt.json"
    if not claimed:
        try:
            prior = json.loads(receipt_path.read_text(encoding="utf-8"))
            prior["replayed"] = True
            emit(prior)
            return 0
        except (OSError, ValueError, TypeError):
            emit(error_result("execution_outcome_unknown", "/workspace"))
            return 3
    try:
        value = execute(arguments.tool, input_document(), safe_cwd(arguments.cwd), call)
    except Exception as error:
        # Stable errors deliberately avoid paths, command text, and file bytes.
        code = str(error)
        allowed = {
            "input_out_of_bounds", "input_invalid", "path_invalid", "path_not_regular",
            "file_out_of_bounds", "range_invalid", "search_invalid", "data_invalid",
            "expected_bytes_mismatch", "expected_sha256_invalid", "expected_sha256_mismatch",
            "expected_current_sha256_invalid", "expected_current_sha256_mismatch",
            "edit_invalid", "edit_expected_text_not_unique", "patch_invalid", "command_invalid",
            "code_invalid", "tool_invalid", "background_identity_invalid",
            "background_receipt_conflict", "background_process_exited_before_receipt",
            "background_process_limit_reached",
            "process_identity_unknown", "process_action_invalid", "process_wait_out_of_bounds",
            "process_write_invalid", "process_write_out_of_bounds", "process_logs_out_of_bounds",
        }
        stable = code if code in allowed else "helper_rejected_operation"
        details = (
            {"kind": "process", "state": "unknown"}
            if arguments.tool in {"process", "receipt"} else None
        )
        value = error_result(stable, safe_cwd(arguments.cwd), details=details)
    atomic_json(receipt_path, value)
    emit(value)
    claims = sorted((item for item in LEDGER.iterdir() if item.is_dir()), key=lambda item: item.stat().st_mtime_ns)
    for old in claims[:-MAX_LEDGER]:
        shutil.rmtree(old)
    return 0


def main() -> int:
    if len(sys.argv) >= 2 and sys.argv[1] == "init-container":
        try:
            initialize_creation_files()
        except (OSError, ValueError):
            return 2
        os.execve("/bin/sleep", ["sleep", "infinity"], {"PATH": "/usr/bin:/bin", "LANG": "C.UTF-8"})
    if len(sys.argv) >= 2 and sys.argv[1] == "readiness":
        if not creation_files_ready():
            return 2
        emit({"ready": True, "schema": 1})
        return 0
    if len(sys.argv) >= 2 and sys.argv[1] == "cancel-call":
        identifier = sys.argv[-1]
        try:
            document = json.loads(
                (LEDGER / identifier / "foreground-process.json").read_text(encoding="utf-8")
            )
            identity = document["identity"]
            pid = identity["pid"]
            marker = f"VOICE_AGENT_INTERNAL_CALL_ID={identifier}".encode("ascii")
            environment = Path(f"/proc/{pid}/environ").read_bytes().split(b"\0")
            if (
                document.get("schema") != 1 or type(pid) is not int
                or _proc_identity(pid) != identity or marker not in environment
                or identity.get("pgid") != pid
            ):
                raise ValueError("identity_mismatch")
            os.killpg(int(identity["pgid"]), signal.SIGTERM)
            deadline = time.monotonic() + 5.0
            while time.monotonic() < deadline and _proc_identity(pid) == identity:
                time.sleep(0.05)
            if _proc_identity(pid) == identity:
                os.killpg(int(identity["pgid"]), signal.SIGKILL)
            emit({"outcome": "signalled"})
        except (KeyError, OSError, TypeError, ValueError):
            emit({"outcome": "identity_unknown"})
        return 0
    parser = argparse.ArgumentParser()
    subparsers = parser.add_subparsers(dest="command", required=True)
    claim = subparsers.add_parser("claim-execute")
    claim.add_argument("--call-id", required=True)
    claim.add_argument("--tool", required=True)
    claim.add_argument("--cwd", required=True)
    put = subparsers.add_parser("credential-file-put")
    put.add_argument("--scope", choices=("creation", "exec"), required=True)
    put.add_argument("--call-id")
    put.add_argument("--name", required=True)
    put.add_argument("--expected-bytes", required=True)
    put.add_argument("--expected-sha256", required=True)
    clean = subparsers.add_parser("credential-file-clean")
    clean.add_argument("--call-id", required=True)
    inbound = subparsers.add_parser("stream-in")
    inbound.add_argument("--transfer-id", required=True)
    inbound.add_argument("--root", choices=tuple(STREAM_ROOTS), required=True)
    inbound.add_argument("--path", required=True)
    inbound.add_argument("--expected-bytes", required=True)
    inbound.add_argument("--expected-sha256", required=True)
    stat_parser = subparsers.add_parser("stream-stat")
    stat_parser.add_argument("--root", choices=tuple(STREAM_ROOTS), required=True)
    stat_parser.add_argument("--path", required=True)
    outbound = subparsers.add_parser("stream-out")
    outbound.add_argument("--root", choices=tuple(STREAM_ROOTS), required=True)
    outbound.add_argument("--path", required=True)
    outbound.add_argument("--expected-bytes", required=True)
    outbound.add_argument("--expected-sha256", required=True)
    arguments = parser.parse_args()
    if arguments.command == "claim-execute":
        return claim_execute(arguments)
    if arguments.command == "credential-file-put":
        return credential_file_put(arguments)
    if arguments.command == "credential-file-clean":
        return credential_file_clean(arguments.call_id)
    if arguments.command == "stream-in":
        return stream_in(arguments)
    if arguments.command == "stream-stat":
        return stream_stat(arguments)
    if arguments.command == "stream-out":
        return stream_out(arguments)
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
