{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voice-agent-v2.invalid/contracts/client-control.v1.schema.json",
  "title": "Voice Agent v2 browser-to-controller control event v1",
  "oneOf": [
    {
      "type": "object",
      "required": ["schema_version", "session_id", "sequence", "type"],
      "properties": {
        "schema_version": {"const": "voice-agent.client-control.v1"},
        "session_id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9][a-z0-9-]{0,63}$(?![\\s\\S])"},
        "sequence": {"type": "integer", "minimum": 1, "maximum": 1000000000},
        "type": {"const": "client.reconnected"}
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["schema_version", "session_id", "turn_id", "stream_epoch", "sequence", "type"],
      "properties": {
        "schema_version": {"const": "voice-agent.client-control.v1"},
        "session_id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9][a-z0-9-]{0,63}$(?![\\s\\S])"},
        "turn_id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9][a-z0-9-]{0,63}$(?![\\s\\S])"},
        "stream_epoch": {"type": "integer", "minimum": 1, "maximum": 1000000000},
        "sequence": {"type": "integer", "minimum": 1, "maximum": 1000000000},
        "type": {"const": "client.playout-completed"}
      },
      "additionalProperties": false
    }
  ]
}
