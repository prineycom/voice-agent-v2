{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voice-agent-v2.local/contracts/observation.v1.schema.json",
  "title": "Voice Agent privacy-safe observation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_sequence", "wall_time", "monotonic_ms", "session_id", "turn_id", "stream_epoch", "stage", "event", "fields"],
  "properties": {
    "schema_version": {"const": "voice-agent.observation.v1"},
    "record_sequence": {"type": "integer", "minimum": 1, "maximum": 1000000000},
    "wall_time": {"type": "string", "minLength": 1, "maxLength": 64},
    "monotonic_ms": {"type": "number", "minimum": 0},
    "session_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "turn_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "stream_epoch": {"type": "integer", "minimum": 1, "maximum": 1000000000},
    "stage": {"type": "string", "minLength": 1, "maxLength": 64},
    "event": {"type": "string", "minLength": 1, "maxLength": 64},
    "fields": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": {
        "oneOf": [
          {"enum": ["provider_time_to_first_token_ms", "server_pcm_queue_max_blocks", "text_salvageable", "tts_time_to_first_audio_ms", "endpoint_to_first_accepted_pcm_ms"]},
          {"type": "string", "pattern": "^(?![\\s\\S]*(?:[Aa][Uu][Dd][Ii][Oo]|[Cc][Oo][Nn][Tt][Ee][Nn][Tt]|[Pp][Cc][Mm]|[Pp][Rr][Oo][Mm][Pp][Tt]|[Rr][Ee][Ss][Pp][Oo][Nn][Ss][Ee]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Tt][Ee][Xx][Tt]|[Tt][Oo][Kk][Ee][Nn]|[Tt][Rr][Aa][Nn][Ss][Cc][Rr][Ii][Pp][Tt]))[\\s\\S]{1,64}$"}
        ]
      },
      "patternProperties": {
        "^dependency_class$": {
          "oneOf": [
            {"enum": ["hard", "soft"]},
            {"type": "boolean"},
            {"type": "number"},
            {"type": "null"}
          ]
        },
        "^(?:action_outcome|admission_version|backend|capability_id|capture_kind|component|contract_version|decision|effective_policy_revision|event_type|failed_event_type|failure_class|failure_code|failure_matrix_id|failure_stage|logical_slot_class|model_identity|outcome|provider_identity|provider_mode|reason_code|request_id|resource_phase|slowest_stage|speaker|speech_outcome|stage|transition|user_state|worker_error_class|worker_id)$": {
          "oneOf": [
            {"type": "string", "maxLength": 512, "pattern": "^[^\\r\\n]*$"},
            {"type": "boolean"},
            {"type": "number"},
            {"type": "null"}
          ]
        }
      },
      "additionalProperties": {
        "oneOf": [
          {"type": "boolean"},
          {"type": "number"},
          {"type": "null"}
        ]
      }
    }
  }
}
