{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voice-agent-v2.local/contracts/agent-profile-runtime-status.v1.schema.json",
  "title": "Restart-only agent profile runtime status v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "reason_code",
    "profile_id",
    "config_revision",
    "effective_policy_revision",
    "effective_authority",
    "effective_capability_count",
    "agent_capabilities_admitted"
  ],
  "properties": {
    "schema_version": {"const": "voice-agent.agent-profile-runtime-status.v1"},
    "status": {"enum": ["active", "degraded"]},
    "reason_code": {"type": "string", "pattern": "^[a-z0-9_]{1,64}$"},
    "profile_id": {
      "oneOf": [
        {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$"},
        {"type": "null"}
      ]
    },
    "config_revision": {
      "oneOf": [
        {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        {"type": "null"}
      ]
    },
    "effective_policy_revision": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "effective_authority": {"const": "deny_all"},
    "effective_capability_count": {"const": 0},
    "agent_capabilities_admitted": {"const": false}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "active"}}},
      "then": {
        "properties": {
          "reason_code": {"const": "agent_profile_active"},
          "profile_id": {"type": "string"},
          "config_revision": {"type": "string"}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "degraded"}}},
      "then": {
        "properties": {
          "profile_id": {"const": null},
          "config_revision": {"const": null}
        }
      }
    }
  ]
}
