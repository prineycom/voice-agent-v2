{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voice-agent-v2.local/contracts/agent-decision.v4.schema.json",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "tool",
        "arguments"
      ],
      "properties": {
        "kind": {
          "const": "operation"
        },
        "tool": {
          "enum": [
            "shell.exec",
            "file.read",
            "file.search",
            "file.write",
            "file.edit",
            "file.patch",
            "execute_code",
            "process",
            "receipt",
            "web.search",
            "web.fetch",
            "web.extract",
            "report.artifact",
            "report.deliver"
          ]
        },
        "arguments": {
          "type": "object"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "answer"
      ],
      "properties": {
        "kind": {
          "const": "final"
        },
        "answer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "citations": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "receipt_id",
              "claims",
              "spans"
            ],
            "properties": {
              "receipt_id": {
                "type": "string",
                "pattern": "^[a-f0-9]{32}$"
              },
              "claims": {
                "type": "array",
                "minItems": 1,
                "maxItems": 16,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                }
              },
              "spans": {
                "type": "array",
                "minItems": 1,
                "maxItems": 16,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                }
              }
            }
          }
        }
      }
    }
  ]
}
