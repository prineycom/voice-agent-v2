{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voice-agent-v2.local/contracts/operation-proposal.v2.schema.json",
  "title": "Voice Agent operation proposal v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "proposal_id", "session_id", "stream_epoch", "turn_id", "request_id", "turn_generation", "capability_id", "arguments"],
  "properties": {
    "schema_version": {"const": "voice-agent.operation-proposal.v2"},
    "proposal_id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "session_id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "stream_epoch": {"type": "integer", "minimum": 1, "maximum": 1000000000},
    "turn_id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "request_id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "turn_generation": {"type": "integer", "minimum": 1, "maximum": 1000000000},
    "capability_id": {"type": "string", "minLength": 1, "maxLength": 96, "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+\\.v[1-9][0-9]*$"},
    "arguments": {"type": "object", "minProperties": 0, "maxProperties": 8}
  }
}
