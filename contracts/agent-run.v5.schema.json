{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voice-agent-v2.local/contracts/agent-run.v5.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "identity", "answer", "decisions", "operations", "operation_count", "action_outcome", "terminal", "provider_mode", "provider_identity", "automatic_fallback", "citations", "research_receipts", "artifact_operations", "deliveries"],
  "properties": {
    "schema_version": {"const": "voice-agent.agent-run.v5"},
    "run_id": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
    "identity": {"type": "object"},
    "answer": {"type": "string", "minLength": 1, "maxLength": 2000},
    "decisions": {"type": "integer", "minimum": 1, "maximum": 24},
    "operations": {"type": "integer", "minimum": 0, "maximum": 24},
    "operation_count": {"type": "integer", "minimum": 0, "maximum": 24},
    "action_outcome": {"enum": ["no_operation", "completed", "failed"]},
    "terminal": {"const": "completed"},
    "provider_mode": {"const": "local"},
    "provider_identity": {"const": "LiquidAI/LFM2.5-2.6B-GGUF@b421ad1d549afeda6a0fb2ad3a697cb5a7879adc#Q4_K_M"},
    "automatic_fallback": {"const": false},
    "citations": {"type": "array", "maxItems": 16, "items": {"$ref": "research-citation.v1.schema.json"}},
    "research_receipts": {"type": "array", "maxItems": 24, "items": {"type": "object"}},
    "artifact_operations": {"type": "array", "maxItems": 24, "items": {"$ref": "report-artifact-operation.v1.schema.json"}},
    "deliveries": {"type": "array", "maxItems": 8, "items": {"$ref": "telegram-delivery.v2.schema.json"}}
  }
}
