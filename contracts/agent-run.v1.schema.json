{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voice-agent-v2.local/contracts/agent-run.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "identity",
    "answer",
    "decisions",
    "operations",
    "terminal",
    "provider_mode",
    "provider_identity",
    "automatic_fallback"
  ],
  "properties": {
    "schema_version": {
      "const": "voice-agent.agent-run.v1"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "identity": {
      "type": "object"
    },
    "answer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "decisions": {
      "type": "integer",
      "minimum": 1,
      "maximum": 24
    },
    "operations": {
      "type": "integer",
      "minimum": 0,
      "maximum": 24
    },
    "terminal": {
      "const": "completed"
    },
    "provider_mode": {
      "const": "local"
    },
    "provider_identity": {
      "const": "LiquidAI/LFM2.5-2.6B-GGUF@b421ad1d549afeda6a0fb2ad3a697cb5a7879adc#Q4_K_M"
    },
    "automatic_fallback": {
      "const": false
    }
  }
}
