{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voice-agent-v2.local/contracts/installation.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "installation_id", "channel", "channel_sequence", "launcher_protocol", "release_id", "healthy_release", "rollback_release", "version", "build_id", "artifact_sha256", "installed_at"],
  "properties": {
    "schema": {"const": "voice-agent.installation.v1"},
    "installation_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "channel": {"const": "stable"},
    "channel_sequence": {"type": "integer", "minimum": 1},
    "launcher_protocol": {"const": 1},
    "release_id": {"type": "string"},
    "healthy_release": {"type": "string"},
    "rollback_release": {"type": "null"},
    "version": {"type": "string"},
    "build_id": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "installed_at": {"type": "string"}
  }
}
