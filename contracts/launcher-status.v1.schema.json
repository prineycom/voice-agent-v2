{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voice-agent-v2.local/contracts/launcher-status.v1.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "launcher", "installation", "selected", "running", "alignment", "rollback", "transaction", "service", "agent_environment", "docker", "legacy", "read_only"],
  "properties": {
    "schema_version": {"const": "voice-agent.launcher-status.v1"},
    "launcher": {"type": "object", "additionalProperties": false, "required": ["version", "protocol"], "properties": {"version": {"type": "string"}, "protocol": {"const": 1}}},
    "installation": {"type": "object", "additionalProperties": false, "required": ["state", "channel"], "properties": {"state": {"enum": ["absent", "canonical", "incomplete", "legacy_unsupported", "invalid"]}, "channel": {"oneOf": [{"const": "stable"}, {"type": "null"}]}}},
    "selected": {"$ref": "#/$defs/identity"}, "running": {"$ref": "#/$defs/identity"},
    "alignment": {"enum": ["selected-running-ready", "selected-new-running-old", "running-only", "selected-not-running", "not-installed", "unknown"]},
    "rollback": {"type": "object", "additionalProperties": false, "required": ["state", "release_id", "version", "build_id"], "properties": {"state": {"enum": ["verified", "verified_legacy", "missing", "invalid"]}, "release_id": {}, "version": {}, "build_id": {}}},
    "transaction": {"type": "object", "additionalProperties": false, "required": ["state", "phase"], "properties": {"state": {"enum": ["none", "present", "invalid"]}, "phase": {}}},
    "service": {"type": "object", "additionalProperties": false, "required": ["state", "enabled", "main_pid_present", "custody"], "properties": {"state": {"enum": ["active", "inactive", "unavailable"]}, "enabled": {}, "main_pid_present": {"type": "boolean"}, "custody": {"enum": ["verified", "unavailable"]}}},
    "agent_environment": {"type": "object", "additionalProperties": false, "required": ["state", "reason_code"], "properties": {"state": {"type": "string"}, "reason_code": {}}},
    "docker": {"type": "object", "additionalProperties": false, "required": ["state", "endpoint_kind", "ownership_verified"], "properties": {"state": {"enum": ["available", "unavailable", "invalid"]}, "endpoint_kind": {"enum": ["none", "rootless"]}, "ownership_verified": {"type": "boolean"}}},
    "legacy": {"type": "object", "additionalProperties": false, "required": ["state", "adoption_eligible", "runtime_custody"], "properties": {"state": {"enum": ["absent", "legacy_unsupported", "invalid"]}, "adoption_eligible": {"type": "boolean"}, "runtime_custody": {"enum": ["verified_ready", "unavailable"]}}},
    "read_only": {"const": true}
  },
  "$defs": {"identity": {"type": "object", "additionalProperties": false, "required": ["state", "release_id", "version", "build_id", "source", "ready"], "properties": {"state": {"type": "string"}, "release_id": {}, "version": {}, "build_id": {}, "source": {"type": "string"}, "ready": {"type": "boolean"}}}}
}
