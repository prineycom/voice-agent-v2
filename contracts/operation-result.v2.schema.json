{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voice-agent-v2.local/contracts/operation-result.v2.schema.json",
  "title": "Voice Agent operation result v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "proposal_id", "session_id", "stream_epoch", "turn_id", "request_id", "turn_generation", "capability_id", "effective_policy_revision", "release_definition_id", "data_classification", "data_base64", "byte_count"],
  "properties": {
    "schema_version": {"const": "voice-agent.operation-result.v2"},
    "proposal_id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "session_id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "stream_epoch": {"type": "integer", "minimum": 1, "maximum": 1000000000},
    "turn_id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "request_id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "turn_generation": {"type": "integer", "minimum": 1, "maximum": 1000000000},
    "capability_id": {"type": "string", "minLength": 1, "maxLength": 96, "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+\\.v[1-9][0-9]*$"},
    "effective_policy_revision": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$"},
    "release_definition_id": {"type": "string", "minLength": 1, "maxLength": 96, "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+\\.v[1-9][0-9]*$"},
    "data_classification": {"const": "external_tool_data"},
    "data_base64": {"type": "string", "minLength": 0, "maxLength": 5464, "pattern": "^[A-Za-z0-9+/]*={0,2}$"},
    "byte_count": {"type": "integer", "minimum": 0, "maximum": 4096}
  }
}
