{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voice-agent-v2.local/contracts/agent-environment-status.v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "state", "config_revision_prefix", "spec_prefix", "generation", "reason_code", "network_egress_enabled", "published_ports", "internal_listeners_may_conflict", "additional_mounts", "additional_mount_authority_warning", "unmounted_host_paths_sockets_devices_accessible", "docker_socket_mounted", "process_receipts", "background_process_limit", "process_poll_required_for_fresh_running_truth", "retained_generations", "lifecycle_selector_supported", "destructive_confirmation_required", "data_deletion_requires_separate_confirmation", "reset_recreates_lazily_under_same_spec", "rebuild_kills_old_processes", "rebuild_retains_old_generation_by_default", "remove_affects_only_current_container", "retire_affects_only_recorded_noncurrent_generation", "conflicts_are_not_automatically_resolved", "visible_conflict_kinds", "credential_configuration_count", "credential_exposure", "credential_authority_warning", "credential_values_or_fingerprints_exposed", "remote_effects_rolled_back_by_cancellation", "automatic_network_or_stream_retry", "rootfs_and_files_persist", "rootfs_persists_until_exact_container_destruction", "workspace_persists_after_reset_rebuild_remove_by_default", "cache_persists_after_reset_rebuild_remove_by_default", "tmpfs_persists_across_container_stop", "processes_survive_controller_events_only_while_container_running", "processes_survive_container_stop", "shell_local_state_persists_across_exec", "logical_cwd_persists_across_exec_and_controller_restart"],
  "properties": {
    "schema_version": {"const": "voice-agent.agent-environment-status.v2"},
    "state": {"enum": ["absent", "creating", "running", "stopped", "exited", "starting", "restarting", "stale_spec", "unhealthy", "resource_stopped", "retiring", "retired", "unavailable", "environment_identity_conflict"]},
    "config_revision_prefix": {"type": "string"}, "spec_prefix": {"type": "string"}, "generation": {"type": "integer"}, "reason_code": {},
    "installation_prefix": {}, "container_id_prefix": {}, "mismatch_fields": {"type": "array"}, "bounds": {"type": "object"},
    "network_egress_enabled": {"type": "boolean"}, "published_ports": {"const": []},
    "internal_listeners_may_conflict": {"const": true},
    "additional_mounts": {
      "type": "array", "maxItems": 16,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["source", "destination", "mode"],
        "properties": {
          "source": {"type": "string"}, "destination": {"type": "string"},
          "mode": {"enum": ["read_only", "read_write"]}
        }
      }
    },
    "additional_mount_authority_warning": {"type": "string", "minLength": 1},
    "unmounted_host_paths_sockets_devices_accessible": {"const": false},
    "docker_socket_mounted": {"const": false},
    "process_receipts": {
      "type": "array", "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["receipt", "state", "observation"],
        "properties": {"receipt": {"type": "string", "pattern": "^[a-f0-9]{32}$"}, "state": {"type": "string"}, "observation": {"const": "last_reconciled"}}
      }
    },
    "background_process_limit": {"const": 64},
    "process_poll_required_for_fresh_running_truth": {"const": true},
    "retained_generations": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["container_id_prefix", "generation", "spec_prefix", "selectable", "last_inspected_state"],
        "properties": {
          "container_id_prefix": {"type": "string"}, "generation": {"type": "integer"},
          "spec_prefix": {"type": "string"}, "selectable": {"const": false},
          "last_inspected_state": {"type": "string"}
        }
      }
    },
    "lifecycle_selector_supported": {"const": false},
    "destructive_confirmation_required": {"const": true},
    "data_deletion_requires_separate_confirmation": {"const": true},
    "reset_recreates_lazily_under_same_spec": {"const": true},
    "rebuild_kills_old_processes": {"const": true},
    "rebuild_retains_old_generation_by_default": {"const": true},
    "remove_affects_only_current_container": {"const": true},
    "retire_affects_only_recorded_noncurrent_generation": {"const": true},
    "conflicts_are_not_automatically_resolved": {"const": true},
    "visible_conflict_kinds": {"type": "array"},
    "credential_configuration_count": {"const": 1},
    "credential_exposure": {
      "type": "array", "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["name", "mode"],
        "properties": {
          "name": {"type": "string", "pattern": "^(?!VOICE_AGENT_)[A-Z_][A-Z0-9_]{0,63}$"},
          "mode": {"enum": ["create_environment", "create_file", "exec_environment", "exec_file"]}
        }
      }
    },
    "credential_authority_warning": {"type": "string", "minLength": 1},
    "credential_values_or_fingerprints_exposed": {"const": false},
    "remote_effects_rolled_back_by_cancellation": {"const": false},
    "automatic_network_or_stream_retry": {"const": false},
    "rootfs_and_files_persist": {"oneOf": [{"type": "boolean"}, {"type": "null"}]},
    "rootfs_persists_until_exact_container_destruction": {"oneOf": [{"type": "boolean"}, {"type": "null"}]},
    "workspace_persists_after_reset_rebuild_remove_by_default": {"const": true},
    "cache_persists_after_reset_rebuild_remove_by_default": {"const": true},
    "tmpfs_persists_across_container_stop": {"const": false},
    "processes_survive_controller_events_only_while_container_running": {"const": true},
    "processes_survive_container_stop": {"const": false},
    "shell_local_state_persists_across_exec": {"const": false},
    "logical_cwd_persists_across_exec_and_controller_restart": {"oneOf": [{"type": "boolean"}, {"type": "null"}]},
    "workspace_and_cache_preserved_by_default": {"const": true}
  }
}
