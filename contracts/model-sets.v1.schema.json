{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voice-agent-v2.local/contracts/model-sets.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "sets"],
  "properties": {
    "schema": {"const": "voice-agent.model-sets.v1"},
    "sets": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["aggregate_sha256", "files", "id", "kind"],
        "properties": {
          "aggregate_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
          "kind": {"enum": ["stt", "llm", "tts", "vad"]},
          "files": {
            "type": "array", "minItems": 1, "maxItems": 8,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["asset_id", "relative_path", "sha256", "size"],
              "properties": {
                "asset_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
                "relative_path": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
                "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "size": {"type": "integer", "minimum": 1}
              }
            }
          }
        }
      }
    }
  }
}
