{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voice-agent-v2.local/contracts/release-channel.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "channel", "sequence", "generated_at", "expires_at", "releases"],
  "properties": {
    "schema": {"const": "voice-agent.channel.v1"},
    "channel": {"const": "stable"},
    "sequence": {"type": "integer", "minimum": 1},
    "generated_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "expires_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "releases": {
      "type": "array", "minItems": 1, "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["version", "build_id", "platform", "artifact_url", "artifact_sha256", "artifact_bytes", "manifest_sha256", "minimum_launcher_protocol", "minimum_data_schema", "maximum_data_schema", "assets", "launcher"],
        "properties": {
          "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$"},
          "build_id": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "platform": {"const": "linux-x86_64-nvidia"},
          "artifact_url": {"type": "string", "maxLength": 2048, "pattern": "^https://"},
          "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "artifact_bytes": {"type": "integer", "minimum": 1},
          "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "minimum_launcher_protocol": {"type": "integer", "minimum": 1},
          "minimum_data_schema": {"type": "integer", "minimum": 1},
          "maximum_data_schema": {"type": "integer", "minimum": 1},
          "assets": {"type": "array", "minItems": 2, "maxItems": 64, "items": {"$ref": "asset-descriptor.v1.schema.json"}},
          "launcher": {"oneOf": [{"$ref": "asset-descriptor.v1.schema.json"}, {"type": "null"}]}
        }
      }
    }
  }
}
