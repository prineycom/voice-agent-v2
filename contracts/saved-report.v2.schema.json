{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voice-agent-v2.local/contracts/saved-report.v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_id", "revision", "current_receipt_id", "prior_receipt_id", "root", "relative_path", "container_path", "byte_count", "sha256", "media_type", "citation_receipt_ids", "sidecar_relative_path", "sidecar_byte_count", "sidecar_sha256"],
  "properties": {
    "schema_version": {"const": "voice-agent.saved-report.v2"},
    "artifact_id": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
    "revision": {"type": "integer", "minimum": 1},
    "current_receipt_id": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
    "prior_receipt_id": {"oneOf": [{"type": "string", "pattern": "^[a-f0-9]{32}$"}, {"type": "null"}]},
    "root": {"const": "workspace"},
    "relative_path": {"type": "string", "pattern": "^reports/(?!\\.delivery/).+"},
    "container_path": {"type": "string", "pattern": "^/workspace/reports/(?!\\.delivery/).+"},
    "byte_count": {"type": "integer", "minimum": 1, "maximum": 262144},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "media_type": {"type": "string", "minLength": 1, "maxLength": 127},
    "citation_receipt_ids": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-f0-9]{32}$"}},
    "sidecar_relative_path": {"type": "string", "pattern": "^reports/\\.delivery/[a-f0-9]{32}\\.json$"},
    "sidecar_byte_count": {"type": "integer", "minimum": 1, "maximum": 262144},
    "sidecar_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
