{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voice-agent-v2.local/contracts/install-transaction.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "phase", "release_id", "version", "build_id", "channel_sequence", "artifact_sha256", "started_at", "updated_at", "reason_code"],
  "properties": {
    "schema": {"const": "voice-agent.install-transaction.v1"},
    "id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "phase": {"enum": ["layout_created", "defaults_written", "release_staged", "release_promoted", "linger_enabled", "unit_installed", "service_started", "ready_verified", "healthy", "failed"]},
    "release_id": {"type": "string", "pattern": "^[0-9A-Za-z][0-9A-Za-z.+-]{0,95}$"},
    "version": {"type": "string"},
    "build_id": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "channel_sequence": {"type": "integer", "minimum": 1},
    "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "started_at": {"type": "string"},
    "updated_at": {"type": "string"},
    "reason_code": {"oneOf": [{"type": "string"}, {"type": "null"}]}
  }
}
