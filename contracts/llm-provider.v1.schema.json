{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voice-agent-v2.invalid/contracts/llm-provider.v1.schema.json",
  "title": "Voice Agent v2 deterministic LLM-provider request/result fixture v1",
  "type": "object",
  "required": ["schema_version", "session_id", "turn_id", "provider", "request", "result"],
  "properties": {
    "schema_version": {"const": "voice-agent.llm-provider.v1"},
    "session_id": {"type": "string", "pattern": "[a-z0-9][a-z0-9-]{0,63}"},
    "turn_id": {"type": "string", "pattern": "[a-z0-9][a-z0-9-]{0,63}"},
    "provider": {
      "type": "object",
      "required": ["mode", "identity"],
      "properties": {
        "mode": {"const": "deterministic-fake"},
        "identity": {"const": "slice-1-fixed-provider"}
      },
      "additionalProperties": false
    },
    "request": {
      "type": "object",
      "required": ["transcript"],
      "properties": {
        "transcript": {"type": "string", "minLength": 1, "maxLength": 4096}
      },
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "required": ["text"],
      "properties": {
        "text": {"type": "string", "minLength": 1, "maxLength": 4096}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
