{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voice-agent-v2.local/contracts/research-citation.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_id", "displayed_url", "title", "retrieved_epoch_seconds", "byte_count", "sha256", "truncated", "redirects", "cache_used", "cache_stale", "network_error", "extraction_error", "claims", "spans"],
  "properties": {
    "schema_version": {"const": "voice-agent.research-citation.v1"},
    "receipt_id": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
    "displayed_url": {"type": "string", "pattern": "^https?://"},
    "title": {"oneOf": [{"type": "string", "maxLength": 512}, {"type": "null"}]},
    "retrieved_epoch_seconds": {"type": "integer", "minimum": 0},
    "byte_count": {"type": "integer", "minimum": 0},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "truncated": {"type": "boolean"},
    "redirects": {"type": "array", "maxItems": 5, "items": {"type": "string", "pattern": "^https?://"}},
    "cache_used": {"type": "boolean"},
    "cache_stale": {"type": "boolean"},
    "network_error": {"oneOf": [{"type": "string"}, {"type": "null"}]},
    "extraction_error": {"oneOf": [{"type": "string"}, {"type": "null"}]},
    "claims": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"type": "string", "minLength": 1, "maxLength": 512}},
    "spans": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"type": "string", "minLength": 1, "maxLength": 512}}
  }
}
