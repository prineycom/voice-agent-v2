{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voice-agent-v2.invalid/contracts/tts.v1.schema.json",
  "title": "Voice Agent v2 deterministic TTS request/chunk fixture v1",
  "type": "object",
  "required": ["schema_version", "session_id", "turn_id", "request", "chunk"],
  "properties": {
    "schema_version": {"const": "voice-agent.tts.v1"},
    "session_id": {"type": "string", "pattern": "[a-z0-9][a-z0-9-]{0,63}"},
    "turn_id": {"type": "string", "pattern": "[a-z0-9][a-z0-9-]{0,63}"},
    "request": {
      "type": "object",
      "required": ["text"],
      "properties": {
        "text": {"type": "string", "minLength": 1, "maxLength": 4096}
      },
      "additionalProperties": false
    },
    "chunk": {
      "type": "object",
      "required": ["sequence", "audio"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 0},
        "audio": {
          "type": "object",
          "required": ["encoding", "sample_rate_hz", "channels", "sample_width_bytes", "byte_count"],
          "properties": {
            "encoding": {"const": "pcm_s16le"},
            "sample_rate_hz": {"const": 16000},
            "channels": {"const": 1},
            "sample_width_bytes": {"const": 2},
            "byte_count": {"type": "integer", "minimum": 1, "maximum": 65536}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
