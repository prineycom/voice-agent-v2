{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voice-agent-v2.local/contracts/admitted-operation.v1.schema.json",
  "title": "Voice Agent admitted operation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "proposal_id", "session_id", "turn_id", "turn_generation", "capability_id", "effective_policy_revision", "release_definition_id", "maximum_result_bytes"],
  "properties": {
    "schema_version": {"const": "voice-agent.admitted-operation.v1"},
    "proposal_id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "session_id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "turn_id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "turn_generation": {"type": "integer", "minimum": 1, "maximum": 1000000000},
    "capability_id": {"type": "string", "minLength": 1, "maxLength": 96, "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+\\.v[1-9][0-9]*$"},
    "effective_policy_revision": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$"},
    "release_definition_id": {"type": "string", "minLength": 1, "maxLength": 96, "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+\\.v[1-9][0-9]*$"},
    "maximum_result_bytes": {"type": "integer", "minimum": 1, "maximum": 4096}
  }
}
