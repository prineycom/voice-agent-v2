{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voice-agent-v2.invalid/contracts/tts.v2.schema.json",
  "title": "Voice Agent v2 backend-neutral correlated TTS segment/result v2",
  "type": "object",
  "required": ["schema_version", "session_id", "stream_epoch", "turn_id", "turn_generation", "request_id", "segment_index", "adapter", "request", "result"],
  "properties": {
    "schema_version": {"const": "voice-agent.tts.v2"},
    "session_id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9][a-z0-9-]{0,63}$(?![\\s\\S])"},
    "stream_epoch": {"type": "integer", "minimum": 1, "maximum": 1000000000},
    "turn_id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9][a-z0-9-]{0,63}$(?![\\s\\S])"},
    "turn_generation": {"type": "integer", "minimum": 1, "maximum": 1000000000},
    "request_id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9][a-z0-9-]{0,63}$(?![\\s\\S])"},
    "segment_index": {"type": "integer", "minimum": 0, "maximum": 4095},
    "adapter": {
      "type": "object",
      "required": ["backend", "model_identity", "speaker", "complete_waveform", "cooperative_cancel", "max_parallel_requests"],
      "properties": {
        "backend": {"type": "string", "minLength": 1, "maxLength": 64},
        "model_identity": {"type": "string", "minLength": 1, "maxLength": 256},
        "speaker": {"type": "string", "minLength": 1, "maxLength": 64},
        "complete_waveform": {"type": "boolean"},
        "cooperative_cancel": {"type": "boolean"},
        "max_parallel_requests": {"type": "integer", "minimum": 1, "maximum": 2}
      },
      "additionalProperties": false
    },
    "request": {
      "type": "object",
      "required": ["text", "text_format", "normalization_version", "audio"],
      "properties": {
        "text": {"type": "string", "minLength": 1, "maxLength": 320},
        "text_format": {"const": "plain"},
        "normalization_version": {"type": "string", "minLength": 1, "maxLength": 128},
        "audio": {
          "type": "object",
          "required": ["encoding", "sample_rate_hz", "channels", "sample_width_bytes"],
          "properties": {
            "encoding": {"const": "pcm_s16le"},
            "sample_rate_hz": {"const": 48000},
            "channels": {"const": 1},
            "sample_width_bytes": {"const": 2}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "required": ["status", "audio", "chunks", "chunk_count", "audio_bytes", "samples", "duration_ms", "terminal_count"],
      "properties": {
        "status": {"const": "success"},
        "audio": {
          "type": "object",
          "required": ["encoding", "sample_rate_hz", "channels", "sample_width_bytes"],
          "properties": {
            "encoding": {"const": "pcm_s16le"},
            "sample_rate_hz": {"const": 48000},
            "channels": {"const": 1},
            "sample_width_bytes": {"const": 2}
          },
          "additionalProperties": false
        },
        "chunks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "required": ["sequence", "byte_count"],
            "properties": {
              "sequence": {"type": "integer", "minimum": 0, "maximum": 63},
              "byte_count": {"type": "integer", "minimum": 1, "maximum": 65536}
            },
            "additionalProperties": false
          }
        },
        "chunk_count": {"type": "integer", "minimum": 1, "maximum": 64},
        "audio_bytes": {"type": "integer", "minimum": 2, "maximum": 1440000},
        "samples": {"type": "integer", "minimum": 1, "maximum": 720000},
        "duration_ms": {"type": "integer", "minimum": 1, "maximum": 15000},
        "terminal_count": {"const": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
