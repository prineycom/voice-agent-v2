{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voice-agent-v2.local/contracts/legacy-import-release.v1.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "release_id", "legacy_release_id", "build_id", "immutable_inventory_sha256", "release_metadata_sha256", "service_unit_sha256", "application_manifest", "readiness", "checked_at"],
  "properties": {
    "schema": {"const": "voice-agent.legacy-import-release.v1"},
    "release_id": {"type": "string", "pattern": "^legacy-[0-9a-f]{24}$"},
    "legacy_release_id": {"type": "string", "pattern": "^[0-9a-f]{24}$"},
    "build_id": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "immutable_inventory_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "release_metadata_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "service_unit_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "application_manifest": {"const": "unsupported"},
    "readiness": {"enum": ["ready", "not_verified"]},
    "checked_at": {"type": "string"}
  }
}
