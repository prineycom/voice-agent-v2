# Copy to .env.slice6 (ignored by Git), then set every blank value.
# Generate a dedicated local pair with the pinned cached `livekit-server generate-keys`.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Controller traffic stays loopback-only. Browser signaling uses tailnet HTTPS.
LIVEKIT_INTERNAL_URL=ws://127.0.0.1:7880
LIVEKIT_PUBLIC_URL=

# The active provider is the pinned cache-local LFM2.5/llama.cpp runtime.
# TTS is fixed in the composition root to Silero v5_5_ru / kseniya for this branch.
# There is no selector, second adapter, co-start, fallback, or cross-adapter retry.
# No provider endpoint, token, alias choice, cloud route, or fallback is configurable.

# Privacy-safe metadata diagnostics are always content-free. Content capture is OFF by
# default. To opt in, add the flag and absolute outside-Git root below to ignored
# .env.slice6. The root must be beneath the exact /run/user/<uid> XDG_RUNTIME_DIR
# tmpfs, and user lingering must be disabled. TTL defaults to 900 seconds; override
# it within 60..3600. docs/architecture.md §8.2 owns the retention/security contract.
# Delete early with ./manage-diagnostics delete <capture-directory>:
# VOICE_AGENT_DIAGNOSTIC_CAPTURE=1
# VOICE_AGENT_DIAGNOSTIC_CAPTURE_ROOT=/run/user/1000/voice-agent-v2/private-captures
# VOICE_AGENT_DIAGNOSTIC_CAPTURE_TTL_SECONDS=900

# This host's Tailscale IPv4 and HTTPS URLs/ports. Tailscale Serve runs in the foreground.
SLICE6_LIVEKIT_NODE_IP=
SLICE6_APP_PUBLIC_URL=
SLICE6_APP_HTTPS_PORT=8443
SLICE6_SIGNAL_HTTPS_PORT=7443
SLICE6_ENABLE_TAILSCALE_SERVE=1
