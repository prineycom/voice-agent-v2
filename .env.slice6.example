# Copy to .env.slice6 (ignored by Git), then set every blank value.
# Generate a dedicated local pair with the pinned cached `livekit-server generate-keys`.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# The application defaults to loopback-only signaling and browser access.
# An operator-owned private reverse proxy may use secure public URLs instead; the
# application never creates, validates, monitors, or removes that exposure.
LIVEKIT_INTERNAL_URL=ws://127.0.0.1:7880
LIVEKIT_PUBLIC_URL=ws://127.0.0.1:7880
SLICE6_APP_PUBLIC_URL=http://127.0.0.1:8000

# The active provider is the pinned cache-local LFM2.5/llama.cpp runtime.
# TTS is fixed in the composition root to Silero v5_5_ru / kseniya for this branch.
# There is no selector, second adapter, co-start, fallback, or cross-adapter retry.
# No provider endpoint, token, alias choice, cloud route, or fallback is configurable.

# Privacy-safe metadata diagnostics are always content-free. Content capture is OFF by
# default. To opt in, add the flag and absolute outside-Git root below to ignored
# .env.slice6. The system service root must be beneath its systemd-owned
# /run/voice-agent-v2 runtime directory. Direct development instead uses the exact
# non-lingering /run/user/<uid> XDG_RUNTIME_DIR tmpfs. TTL defaults to 900 seconds;
# override it within 60..3600. docs/architecture.md §8.2 owns the contract.
# Delete early with ./manage-diagnostics delete <capture-directory>:
# VOICE_AGENT_DIAGNOSTIC_CAPTURE=1
# VOICE_AGENT_DIAGNOSTIC_CAPTURE_ROOT=/run/voice-agent-v2/private-captures
# VOICE_AGENT_DIAGNOSTIC_CAPTURE_TTL_SECONDS=900

# External exposure is optional and entirely operator-owned. Never bind the application
# directly to wildcard/public interfaces or put it behind a proxy without appropriate
# private-network/access controls.
