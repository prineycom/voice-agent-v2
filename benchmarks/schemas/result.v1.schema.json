{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voice-agent-v2.local/schemas/slice2-result.v1.schema.json",
  "title": "Privacy-safe Slice 2 local benchmark result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "preregistration_commit", "run_id", "candidate_id", "role", "artifact", "runtime", "configuration", "input_revision", "host_capture_sha256", "phases", "quality", "cancellation_recovery", "gates", "raw_evidence", "outcome"],
  "properties": {
    "schema_version": {"type": "string", "const": "voice-agent.slice2-result.v1"},
    "preregistration_commit": {"type": "string", "pattern": "[0-9a-f]{40}"},
    "run_id": {"type": "string", "pattern": "run-[a-z0-9-]{6,80}"},
    "candidate_id": {"type": "string", "pattern": "[a-z0-9][a-z0-9-]{2,63}"},
    "role": {"type": "string", "enum": ["stt", "llm", "tts", "stack"]},
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "revision", "quantization", "license", "files"],
      "properties": {
        "repository": {"type": "string", "minLength": 10},
        "revision": {"type": "string", "pattern": "[0-9a-f]{40}"},
        "quantization": {"type": "string", "minLength": 2},
        "license": {"type": "string", "minLength": 3},
        "files": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["name", "bytes", "sha256"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "bytes": {"type": "integer", "minimum": 1},
              "sha256": {"type": "string", "pattern": "[0-9a-f]{64}"}
            }
          }
        }
      }
    },
    "runtime": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "version", "revision", "device_api", "driver_version", "dependency_lock_sha256"],
      "properties": {
        "name": {"type": "string", "minLength": 2},
        "version": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "pattern": "[0-9a-f]{40}"},
        "device_api": {"type": "string", "enum": ["CPU", "CUDA", "Vulkan", "mixed"]},
        "driver_version": {"type": "string", "minLength": 3},
        "dependency_lock_sha256": {"type": "string", "pattern": "[0-9a-f]{64}"}
      }
    },
    "configuration": {
      "type": "object", "additionalProperties": false,
      "required": ["context_size", "concurrency_levels", "maximum_active_requests", "resident", "maximum_generated_tokens", "sampling"],
      "properties": {
        "context_size": {"type": "integer", "minimum": 0},
        "concurrency_levels": {"type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": {"type": "integer", "minimum": 1, "maximum": 4}},
        "maximum_active_requests": {"type": "integer", "minimum": 1, "maximum": 4},
        "resident": {"type": "boolean"},
        "maximum_generated_tokens": {"type": "integer", "minimum": 0},
        "sampling": {"type": "string", "minLength": 3}
      }
    },
    "input_revision": {"type": "string", "pattern": "[0-9a-f]{64}"},
    "host_capture_sha256": {"type": "string", "pattern": "[0-9a-f]{64}"},
    "phases": {
      "type": "array", "minItems": 3,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "iterations", "metrics", "failure_count"],
        "properties": {
          "name": {"type": "string", "enum": ["cold", "warm", "sustained", "overlap", "repeat"]},
          "iterations": {"type": "integer", "minimum": 1},
          "metrics": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["name", "unit", "statistic", "value"],
              "properties": {
                "name": {"type": "string", "pattern": "[a-z][a-z0-9_]{2,80}"},
                "unit": {"type": "string", "enum": ["milliseconds", "seconds", "ratio", "percent", "mib", "count", "tokens_per_second", "bytes"]},
                "statistic": {"type": "string", "enum": ["idle", "peak", "minimum", "maximum", "mean", "p05", "p50", "p95", "total", "slope"]},
                "value": {"type": "number", "minimum": 0}
              }
            }
          },
          "failure_count": {"type": "integer", "minimum": 0}
        }
      }
    },
    "quality": {
      "type": "object", "additionalProperties": false,
      "required": ["rubric_revision", "sample_count", "metrics", "critical_failure_count", "blind_reviewed"],
      "properties": {
        "rubric_revision": {"type": "string", "pattern": "[0-9a-f]{64}"},
        "sample_count": {"type": "integer", "minimum": 1},
        "metrics": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["name", "value"],
            "properties": {
              "name": {"type": "string", "pattern": "[a-z][a-z0-9_]{2,80}"},
              "value": {"type": "number", "minimum": 0}
            }
          }
        },
        "critical_failure_count": {"type": "integer", "minimum": 0},
        "blind_reviewed": {"type": "boolean"}
      }
    },
    "cancellation_recovery": {
      "type": "object", "additionalProperties": false,
      "required": ["cancel_to_last_output_ms", "resource_release_ms", "stale_output_count", "recovery_ready_ms", "recovery_latency_ms", "recovery_passed"],
      "properties": {
        "cancel_to_last_output_ms": {"type": "number", "minimum": 0},
        "resource_release_ms": {"type": "number", "minimum": 0},
        "stale_output_count": {"type": "integer", "minimum": 0},
        "recovery_ready_ms": {"type": "number", "minimum": 0},
        "recovery_latency_ms": {"type": "number", "minimum": 0},
        "recovery_passed": {"type": "boolean"}
      }
    },
    "gates": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "comparison", "threshold", "observed", "passed"],
        "properties": {
          "name": {"type": "string", "pattern": "[a-z][a-z0-9_]{2,80}"},
          "comparison": {"type": "string", "enum": ["less_or_equal", "greater_or_equal", "equal"]},
          "threshold": {"type": "number", "minimum": 0},
          "observed": {"type": "number", "minimum": 0},
          "passed": {"type": "boolean"}
        }
      }
    },
    "raw_evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["outside_git", "sha256", "bytes"],
      "properties": {
        "outside_git": {"type": "boolean", "const": true},
        "sha256": {"type": "string", "pattern": "[0-9a-f]{64}"},
        "bytes": {"type": "integer", "minimum": 1}
      }
    },
    "outcome": {"type": "string", "enum": ["pass", "fail"]}
  }
}
