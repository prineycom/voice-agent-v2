{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voice-agent-v2.local/schemas/slice2-candidates.v1.schema.json",
  "title": "Slice 2 screened local candidates",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy", "shared_runtime", "candidates", "screened_out"],
  "properties": {
    "schema_version": {"type": "string", "const": "voice-agent.slice2-candidates.v1"},
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["local_only", "cloud_contacted", "preferred_llm_status", "llm_single_model_exception"],
      "properties": {
        "local_only": {"type": "boolean", "const": true},
        "cloud_contacted": {"type": "boolean", "const": false},
        "preferred_llm_status": {"type": "string", "enum": ["awaiting-exact-identity", "supplied"]},
        "llm_single_model_exception": {"type": "string", "minLength": 20, "maxLength": 800}
      }
    },
    "shared_runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python", "stt", "tts", "llm", "expected_download_bytes"],
      "properties": {
        "python": {"type": "string", "minLength": 3},
        "stt": {"type": "string", "minLength": 3},
        "tts": {"type": "string", "minLength": 3},
        "llm": {"type": "string", "minLength": 3},
        "expected_download_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "candidates": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role", "priority", "artifact", "runtime", "configuration", "screen"],
        "properties": {
          "id": {"type": "string", "pattern": "[a-z0-9][a-z0-9-]{2,63}"},
          "role": {"type": "string", "enum": ["stt", "llm", "tts"]},
          "priority": {"type": "string", "enum": ["fixed", "conditional-alternative", "preferred-first", "runtime-comparison"]},
          "artifact": {
            "type": "object",
            "additionalProperties": false,
            "required": ["repository", "revision", "provenance", "quantization", "license", "files"],
            "properties": {
              "repository": {"type": "string", "pattern": "https://huggingface\\.co/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+"},
              "revision": {"type": "string", "pattern": "[0-9a-f]{40}"},
              "provenance": {"type": "string", "minLength": 10, "maxLength": 500},
              "quantization": {"type": "string", "minLength": 2, "maxLength": 80},
              "license": {"type": "string", "minLength": 3, "maxLength": 120},
              "files": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["path", "url", "size_bytes"],
                  "properties": {
                    "path": {"type": "string", "minLength": 1, "maxLength": 200},
                    "url": {"type": "string", "pattern": "https://huggingface\\.co/.+"},
                    "size_bytes": {"type": "integer", "minimum": 1},
                    "sha256": {"type": "string", "pattern": "[0-9a-f]{64}"},
                    "git_blob_sha1": {"type": "string", "pattern": "[0-9a-f]{40}"}
                  }
                }
              }
            }
          },
          "runtime": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "version", "revision", "license", "device_api"],
            "properties": {
              "name": {"type": "string", "minLength": 2},
              "version": {"type": "string", "minLength": 1},
              "revision": {"type": "string", "pattern": "[0-9a-f]{40}"},
              "license": {"type": "string", "minLength": 3},
              "device_api": {"type": "string", "enum": ["CUDA", "CPU", "Vulkan"]}
            }
          },
          "configuration": {
            "type": "object",
            "additionalProperties": false,
            "required": ["context_size", "concurrency_levels", "maximum_active_requests", "resident"],
            "properties": {
              "context_size": {"type": "integer", "minimum": 0},
              "concurrency_levels": {"type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": {"type": "integer", "minimum": 1, "maximum": 4}},
              "maximum_active_requests": {"type": "integer", "minimum": 1, "maximum": 4},
              "resident": {"type": "boolean"}
            }
          },
          "screen": {
            "type": "object",
            "additionalProperties": false,
            "required": ["testable", "ungated_acquisition", "license_review", "compatibility_evidence"],
            "properties": {
              "testable": {"type": "boolean"},
              "ungated_acquisition": {"type": "boolean"},
              "license_review": {"type": "string", "minLength": 15, "maxLength": 1000},
              "compatibility_evidence": {"type": "string", "minLength": 15, "maxLength": 1000}
            }
          }
        }
      }
    },
    "screened_out": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["identity", "role", "reason"],
        "properties": {
          "identity": {"type": "string", "minLength": 3},
          "role": {"type": "string", "enum": ["stt", "llm", "tts"]},
          "reason": {"type": "string", "minLength": 15}
        }
      }
    }
  }
}
