{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voice-agent-v2.local/schemas/tts-rubric.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "origin", "audio_contract", "blind_review", "scale", "dimensions", "samples"],
  "properties": {
    "schema_version": {"type": "string", "const": "voice-agent.slice2-tts-rubric.v1"},
    "origin": {"type": "string", "minLength": 20},
    "audio_contract": {
      "type": "object", "additionalProperties": false,
      "required": ["output", "normalization", "retention"],
      "properties": {
        "output": {"type": "string", "minLength": 10},
        "normalization": {"type": "string", "minLength": 10},
        "retention": {"type": "string", "minLength": 10}
      }
    },
    "blind_review": {"type": "string", "minLength": 20},
    "scale": {"type": "object"},
    "dimensions": {"type": "array", "minItems": 3, "items": {"type": "string", "minLength": 3}},
    "samples": {
      "type": "array", "minItems": 12,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "category", "utterance", "listen_for"],
        "properties": {
          "id": {"type": "string", "pattern": "tts-[0-9]{2}"},
          "category": {"type": "string", "minLength": 3},
          "utterance": {"type": "string", "minLength": 3},
          "listen_for": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}}
        }
      }
    }
  }
}
