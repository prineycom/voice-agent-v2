#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
CONFIG=$ROOT/.env.slice6
[ -f "$CONFIG" ] || {
  echo "Missing required untracked server configuration: $CONFIG" >&2
  echo "Copy .env.slice6.example to .env.slice6 and set every required value." >&2
  exit 2
}
set -a
# This file is explicit operator-owned server configuration and must remain untracked.
. "$CONFIG"
set +a
if [ "${VOICE_AGENT_FORCE_PARAKEET_CANDIDATE:-0}" = 1 ]; then
  VOICE_AGENT_STT_BACKEND=parakeet
  export VOICE_AGENT_STT_BACKEND
  unset VOICE_AGENT_FORCE_PARAKEET_CANDIDATE
fi

CACHE=${XDG_CACHE_HOME:-"$HOME/.cache"}/voice-agent-v2/slice-6
PYTHON=$CACHE/runtime/venv/bin/python
[ -x "$PYTHON" ] || {
  echo "Slice 6 runtime is missing; run ./setup-slice6" >&2
  exit 2
}
if [ "${VOICE_AGENT_STT_BACKEND:-whisper}" = parakeet ]; then
  LOCK=/home/priney/.cache/voice-agent-v2/experiments/gpu-bakeoff.lock
  command -v flock >/dev/null || {
    echo "flock is required to serialize the candidate GPU lifetime" >&2
    exit 2
  }
  mkdir -p "$(dirname "$LOCK")"
  exec flock --exclusive --nonblock "$LOCK" \
    "$PYTHON" "$ROOT/scripts/run_slice6.py"
fi
exec "$PYTHON" "$ROOT/scripts/run_slice6.py"
